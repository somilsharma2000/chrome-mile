# Copy this file to .env.local and fill in your real values.
# Sitemap/robots base URL — set to your live domain after deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in international format, no "+" (used for order CTAs)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Instagram handle (without @) — shown in the footer
NEXT_PUBLIC_INSTAGRAM=continental12
